{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bastet Agent Sync",
  "version": "0.4.2",
  "identifier": "tw.bastet.agent-sync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bastet Agent Sync",
        "width": 1140,
        "height": 840,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDQjIxQ0RBQjEwMUQzQjcKUldTMzB3R3gyaHl5VEZpMC9IR2N1Tmd6aHo2ZTRuZm1CMEtlNTc1aW9ham5QMUtuTFJZeHVaOEsK",
      "endpoints": [
        "https://github.com/yamantaka520/Bastet-Agent-Sync/releases/latest/download/latest.json"
      ]
    }
  }
}
